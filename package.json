{
  "name": "stitch-pet-electron",
  "version": "1.2.0",
  "description": "史迪奇桌面宠物（Electron 版）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never"
  },
  "author": "StitchPet",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AKIhunter/electron_pet.git"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.stitch.pet",
    "productName": "electron_pet",
    "electronDist": "node_modules/electron/dist",
    "artifactName": "${productName}-v${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "flee.js",
      "updater.js",
      "office-watch.ps1",
      "config.json",
      "renderer/**/*",
      "reminder/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "office-watch.ps1"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "史迪奇桌宠"
    }
  }
}